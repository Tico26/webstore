  "POST /api/categories": {
    "description": "creates a category in the database",
    "queries": ["category_name", "category_description"],
    "exampleResponse": {
      "category": [
        {
          "category_id": 5,
          "category_name": "category_name_example",
          "category_description": "category_description_example"
        }
      ]
    }
  },
  "PATCH /api/categories/:category_id": {
    "description": "updates a category in the database according to its ID",
    "queries": ["category_id", "category_name", "category_description"],
    "exampleResponse": {
      "category": [
        {
          "category_id": 1,
          "category_name": "updated_category_name",
          "category_description": "updated_category_description"
        }
      ]
    }
  },
  "DELETE /api/categories/:category_id": {
    "description": "deletes a single category according to its ID",
    "queries": ["category_id"],
    "requestParam": {
      "category_id": 1
    },
