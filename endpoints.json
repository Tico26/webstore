      ]
    }
  },
  "POST /api/user/login": {
    "description": "authenticates user login",
    "queries": ["email", "username", "password_hash"],
    "exampleResponse": "Successful login"
  },
  "DELETE /api/user/:user_id": {
    "description": "deletes a single user",
    "queries": ["user_id"],
    "requestParam": {
      "user_id": 1
    },
    "exampleResponse": "Successfully Deleted User: 1"
  },
  "GET /api/categories": {
    "description": "serves a json representation of all categories",
    "queries": [],
    "exampleResponse": {
      "allCategories": [
        {
          "category_id": 322,
          "category_name": "category_name_example_1",
          "category_description": "category_name_description_1"
        },
        {
          "category_id": 294,
