  "POST /api/user": {
    "description": "creates a user in the database",
    "queries": [
      "first_name",
      "last_name",
      "email",
      "date_of_birth",
      "username",
      "password_hash",
      "is_admin"
    ],
    "exampleResponse": {
      "user": [
        {
          "shop_id": 1,
          "shop_name": "LaMona Vintage",
          "shop_description": "A curated vintage fashion boutique.",
          "shop_url": "https://lamona.example.com",
          "logo_url": "https://lamona.example.com/logo.png",
          "location": "Manchester",
